fn calculate_pi (n_terms) do
	const terms = n_terms * 2.0 + 1.0
	let pi = 0.0
	let denominator = 1.0
	let operation = 1.0
	
	while denominator < terms do
		pi += operation * (4.0 / denominator)
		denominator += 2.0
		operation *= -1.0
	end
	
	pi
end

fn main() do
	let n = 1000000.0
	let result = calculate_pi(n)
	print(result)
end

main()
